<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.rk_aiz.teamsurvey.infrastructure.mapper.mybatis.SurveyMapper">

    <!-- 
		マッピング定義 (ResultMap)
		DBの結合結果を、EnqueteオブジェクトとList<Question>にマッピングします
		
		※Enum型 (status, resultVisibility, type等) はデフォルトで定数名(String)としてマッピングされます。
		数値(Ordinal)や独自のコード値でマッピングする場合は、typeHandler属性の指定や@EnumValueの設定が必要です。
        TODO : このマッピングの実行回数を、Redisなどで減らせるか調査
    -->
    <resultMap id="SurveyResultMap" type="com.github.rk_aiz.teamsurvey.infrastructure.entity.SurveyEntity">
        <id property="id" column="id" />
        <result property="title" column="title" />
        <result property="status" column="status" />
        <!-- 例: Ordinal(数値)でマッピングする場合 -->
        <!-- <result property="status" column="status" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler" /> -->
        <result property="resultVisibility" column="result_visibility" />
        <result property="deadline" column="deadline" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <!-- 全件取得: ここでは質問リストは取得せず、軽量にする -->
    <select id="selectAll" resultType="com.github.rk_aiz.teamsurvey.infrastructure.entity.SurveyEntity"> SELECT id, title,
        created_at, updated_at FROM surveys ORDER BY id </select>

    <!-- ヘッダーのみ取得 (軽量: 質問リストなどは取得しない) -->
    <select id="selectHeaderById" resultType="com.github.rk_aiz.teamsurvey.infrastructure.entity.SurveyEntity">
        SELECT id, title, status, result_visibility, deadline, created_at, updated_at
        FROM surveys
        WHERE id = #{id}
    </select>

    <!-- ID指定取得: 単純なSELECTに変更 -->
    <select id="selectById" resultMap="SurveyResultMap">
        SELECT  id, 
                title,
                status,
                result_visibility,
                deadline,
                created_at,
                updated_at
        FROM    surveys
        WHERE id = #{id}
    </select>

    <!-- 権限グループの取得 -->
    <select id="selectAllowedGroups" resultType="com.github.rk_aiz.teamsurvey.infrastructure.entity.UserGroupEntity">
        SELECT g.id, g.group_name 
        FROM user_groups g
        INNER JOIN survey_target_groups ep ON g.id = ep.group_id
        WHERE ep.survey_id = #{surveyId}
        ORDER BY g.id
    </select>

    <insert id="insertPermission">
        INSERT INTO survey_target_groups (survey_id, group_id) VALUES (#{surveyId}, #{groupId})
    </insert>

    <delete id="deletePermissions">
        DELETE FROM survey_target_groups WHERE survey_id = #{surveyId}
    </delete>

    <!-- 
        ログインユーザーが回答可能なアンケート一覧を取得
        ユーザーの所属グループ(user_group_mappings)と、
        アンケートの公開権限(survey_target_groups)を結合して動的に判定します。
        これにより、将来グループに追加されたユーザーも自動的に対象になります。
    -->
    <select id="selectByUserId" resultType="com.github.rk_aiz.teamsurvey.infrastructure.entity.SurveyEntity">
        SELECT DISTINCT
            e.id, e.title, e.allow_guest, e.status, e.result_visibility, 
            e.deadline, e.created_at, e.updated_at
        FROM surveys e
        INNER JOIN survey_target_groups ep ON e.id = ep.survey_id
        INNER JOIN user_group_mappings ugm ON ep.group_id = ugm.group_id
        WHERE 
            ugm.username = #{userId}
            AND e.status = 'PUBLISHED'
            AND (e.deadline IS NULL OR e.deadline > CURRENT_TIMESTAMP)
        ORDER BY 
            e.created_at DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id"> INSERT INTO surveys (title, created_at, updated_at) VALUES (#{title},
        CURRENT_TIMESTAMP, CURRENT_TIMESTAMP) </insert>

    <update id="update"> 
        UPDATE surveys 
        SET title = #{title}, 
            allow_guest = #{allowGuest},
            status = #{status},
            result_visibility = #{resultVisibility},
            deadline = #{deadline},
            updated_at = CURRENT_TIMESTAMP 
        WHERE id = #{id} 
    </update>

    <delete id="delete"> DELETE FROM surveys WHERE id = #{id} </delete>

</mapper>